[Unit]
Description=homelab backend (metrics, rules, notifications)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=homelab
Group=homelab
SupplementaryGroups=docker video
WorkingDirectory=/opt/homelab
ExecStart=/opt/homelab/bin/homelab-arm64 -data-dir /var/lib/homelab -listen 127.0.0.1:8000
EnvironmentFile=-/etc/homelab.env
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=true
Restart=on-failure
RestartSec=3
StateDirectory=homelab
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/homelab

[Install]
WantedBy=multi-user.target