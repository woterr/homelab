[Unit]
Description=homelab backend (metrics, rules, notifications)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=user
Group=user
SupplementaryGroups=docker video
WorkingDirectory=/home/user/homelab
ExecStart=/home/user/homelab/backend/bin/homelab-arm64 -data-dir /home/user/homelab/data -listen 127.0.0.1:8000
EnvironmentFile=-/etc/homelab.env
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=true
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target