# homelab backend environment — copy to /etc/homelab.env (chmod 600).
# Values here seed the notification channels; settings saved from the Settings
# page are stored in the database and layered on top. Leave unused keys empty.

# ntfy
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=homelab-alerts

# discord
DISCORD_WEBHOOK=

# email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# phone (SMS gateway webhook)
PHONE_WEBHOOK=
PHONE_TO=

# tuning (optional)
COLLECT_INTERVAL=5s
RETENTION=720h
# DEVICE_SWEEP=true