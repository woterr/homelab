# homelab web — standalone Caddy for the Raspberry Pi (systemd, no Docker).
#
# Serves the built frontend and proxies /api + WebSocket to the native backend
# on 127.0.0.1:8000. The NAS's own Caddy instance on :80 is left untouched;
# homelab listens on :8090 (matching the historic dashboard port).
#
# Paths are absolute (/opt/homelab) since this file is loaded by the
# homelab-caddy systemd unit, not by a container.

:8090 {
	encode zstd gzip

	root * /opt/homelab/frontend/dist

	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		try_files {path} /index.html
		file_server
	}

	header {
		- Server
		X-Powered-By "homelab"
	}
}